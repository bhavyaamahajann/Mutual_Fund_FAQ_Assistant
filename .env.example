# =============================================================================
# Mutual Fund FAQ Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---------- Groq ----------
# Required: Your Groq API key for LLM generation
GROQ_API_KEY=gsk_your_groq_api_key_here

# ---------- Model Configuration ----------
# Embedding model used for vectorizing chunks and queries (local model, downloaded automatically)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# LLM model used for response generation (run via Groq)
LLM_MODEL=llama-3.3-70b-versatile


# ---------- RAG Configuration ----------
# Number of top chunks to retrieve for each query
TOP_K=3

# Chunk size in characters for text splitting
CHUNK_SIZE=500

# Overlap between consecutive chunks in characters
CHUNK_OVERLAP=50

# ---------- Server ----------
# Host and port for the FastAPI server
HOST=0.0.0.0
PORT=8000
